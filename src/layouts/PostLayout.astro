---
import BlogLayout from './BlogLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comment from '../components/waline/Comment.astro';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings: MarkdownHeading[];
  cover?: string;
  /** Docs mode: room for a right-hand page-nav rail. */
  variant?: 'default' | 'docs';
}

const { title, description, headings, cover, variant = 'default' } = Astro.props;
const isDocs = variant === 'docs';
const hasToc = headings && headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 0;
---

<BlogLayout title={title} description={description} ogType="article" image={cover} variant={variant}>
  <slot name="drawer" slot="drawer" />

  {
    cover && (
      <div class="rounded-2xl overflow-hidden mb-8 aspect-[2/1] bg-gray-100 dark:bg-gray-800">
        <img
          src={cover}
          alt={title}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    )
  }

  <div class="flex flex-col xl:flex-row gap-6">
    <div class="flex-1 min-w-0">
      <article class="prose max-w-none">
        <slot />
      </article>
      <div class="mt-10 pt-8 border-t border-gray-100 dark:border-gray-800">
        <Comment />
      </div>
    </div>

    {
      (isDocs || hasToc) && (
        <aside class={`hidden xl:block shrink-0 ${isDocs ? 'w-72' : 'w-52'}`}>
          <div class="sticky top-24 space-y-4 max-h-[calc(100vh-6.5rem)] overflow-y-auto pr-1">
            <slot name="aside" />
            {hasToc && <TableOfContents headings={headings} />}
          </div>
        </aside>
      )
    }
  </div>
</BlogLayout>
