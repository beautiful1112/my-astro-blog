---
import BlogLayout from './BlogLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comment from '../components/waline/Comment.astro';

interface MarkdownHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings: MarkdownHeading[];
  cover?: string;
}

const { title, description, headings, cover } = Astro.props;
---

<BlogLayout title={title} description={description} ogType="article" image={cover}>
  {
    cover && (
      <div class="rounded-2xl overflow-hidden mb-8 aspect-[2/1] bg-gray-100 dark:bg-gray-800">
        <img
          src={cover}
          alt={title}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    )
  }

  <div class="flex flex-col xl:flex-row gap-6">
    <div class="flex-1 min-w-0">
      <article class="prose max-w-none">
        <slot />
      </article>
      <div class="mt-10 pt-8 border-t border-gray-100 dark:border-gray-800">
        <Comment />
      </div>
    </div>

    {
      headings && headings.length > 0 && (
        <aside class="hidden xl:block w-52 shrink-0">
          <div class="sticky top-24">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )
    }
  </div>
</BlogLayout>
