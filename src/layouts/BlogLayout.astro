---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  ogType?: string;
  image?: string;
  /** Docs mode: hide profile sidebar so a right-hand content nav can use the space. */
  variant?: 'default' | 'docs';
}

const { title, description, ogType, image, variant = 'default' } = Astro.props;
const isDocs = variant === 'docs';
---

<BaseLayout title={title} description={description} ogType={ogType} image={image}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-8 py-8">
      {
        !isDocs && (
          <aside class="hidden lg:block w-full lg:w-80 shrink-0 order-first">
            <div class="sticky top-20 space-y-6">
              <Sidebar />
            </div>
          </aside>
        )
      }

      <div class="flex-1 min-w-0">
        <slot />
      </div>

      <button
        id="sidebar-toggle"
        class={`${isDocs ? 'xl:hidden' : 'lg:hidden'} fixed bottom-6 right-6 z-40 w-12 h-12 bg-primary text-white rounded-full shadow-lg flex items-center justify-center hover:bg-primary-dark transition-colors`}
        aria-label={isDocs ? 'Open page navigation' : 'Open sidebar'}
      >
        {
          isDocs ? (
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h14" />
            </svg>
          ) : (
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
          )
        }
      </button>

      <div
        id="sidebar-drawer"
        class={`${isDocs ? 'xl:hidden' : 'lg:hidden'} fixed inset-0 z-50 pointer-events-none`}
        aria-hidden="true"
        inert
      >
        <div
          id="sidebar-backdrop"
          class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"
        ></div>
        <div
          id="sidebar-panel"
          class="absolute right-0 top-0 h-full w-80 max-w-[85vw] bg-white dark:bg-[var(--color-bg-dark)] shadow-2xl transform translate-x-full transition-transform duration-300 overflow-y-auto"
        >
          <div class="p-4">
            <button
              id="sidebar-close"
              class="mb-4 p-2 rounded-lg text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
              aria-label="Close sidebar"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            {
              isDocs ? (
                <slot name="drawer" />
              ) : (
                <Sidebar />
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function bindSidebarDrawer() {
    const toggle = document.getElementById('sidebar-toggle');
    const drawer = document.getElementById('sidebar-drawer');
    const backdrop = document.getElementById('sidebar-backdrop');
    const panel = document.getElementById('sidebar-panel');
    const close = document.getElementById('sidebar-close');

    if (!toggle || !drawer || !backdrop || !panel) return;

    function openSidebar() {
      drawer?.removeAttribute('inert');
      drawer?.setAttribute('aria-hidden', 'false');
      drawer?.classList.remove('pointer-events-none');
      backdrop?.classList.remove('opacity-0');
      backdrop?.classList.add('opacity-100');
      panel?.classList.remove('translate-x-full');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0');
      panel?.classList.add('translate-x-full');
      setTimeout(() => {
        drawer?.setAttribute('inert', '');
        drawer?.setAttribute('aria-hidden', 'true');
        drawer?.classList.add('pointer-events-none');
        document.body.style.overflow = '';
      }, 300);
    }

    toggle.onclick = openSidebar;
    close && (close.onclick = closeSidebar);
    backdrop.onclick = closeSidebar;
  }

  bindSidebarDrawer();
  document.addEventListener('astro:after-swap', bindSidebarDrawer);

  document.addEventListener('keydown', (e) => {
    const drawer = document.getElementById('sidebar-drawer');
    if (e.key === 'Escape' && drawer?.getAttribute('aria-hidden') === 'false') {
      const backdrop = document.getElementById('sidebar-backdrop');
      const panel = document.getElementById('sidebar-panel');
      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0');
      panel?.classList.add('translate-x-full');
      setTimeout(() => {
        drawer?.setAttribute('inert', '');
        drawer?.setAttribute('aria-hidden', 'true');
        drawer?.classList.add('pointer-events-none');
        document.body.style.overflow = '';
      }, 300);
    }
  });
</script>
