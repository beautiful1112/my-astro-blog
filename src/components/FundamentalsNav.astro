---
import type { NoteTopic } from '../utils/notes';
import { noteHref, topicHref } from '../utils/notes';

interface Props {
  topic: NoteTopic;
  currentId?: string;
}

const { topic, currentId } = Astro.props;
const currentKey = currentId?.toLowerCase();

function isCurrent(id: string): boolean {
  return id.toLowerCase() === currentKey;
}

function moduleIsActive(mod: NoteTopic['modules'][number]): boolean {
  if (mod.indexId && isCurrent(mod.indexId)) return true;
  return mod.notes.some((note) => isCurrent(note.id));
}
---

<nav
  class="bg-white dark:bg-[var(--color-card-dark)] rounded-2xl shadow-sm p-5"
  aria-label={`${topic.label} page navigation`}
>
  <div class="mb-4 pb-3 border-b border-gray-100 dark:border-gray-700/80">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400 mb-1">
      Jump to
    </p>
    <a
      href={topicHref(topic.id)}
      class="text-sm font-semibold text-gray-900 dark:text-gray-100 hover:text-primary transition-colors capitalize"
    >
      {topic.label} index
    </a>
  </div>

  <ul class="space-y-1 text-sm">
    {
      topic.modules.map((mod) => {
        const open = moduleIsActive(mod);
        return (
          <li>
            <details class="group/nav" open={open || undefined}>
              <summary class="flex items-start gap-1.5 cursor-pointer list-none rounded-lg px-2 py-1.5 text-gray-700 dark:text-gray-200 hover:bg-primary/5 hover:text-primary transition-colors [&::-webkit-details-marker]:hidden">
                <svg
                  class="w-3.5 h-3.5 mt-0.5 shrink-0 text-gray-400 transition-transform group-open/nav:rotate-90"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span class={`leading-snug ${open ? 'font-semibold text-gray-900 dark:text-gray-100' : ''}`}>
                  {mod.label}
                </span>
              </summary>

              <ul class="mt-1 mb-2 ml-3.5 pl-3 border-l border-gray-200 dark:border-gray-700 space-y-0.5">
                {
                  mod.indexId && (
                    <li>
                      <a
                        href={noteHref('/fundamentals', mod.indexId)}
                        class={`block rounded-md px-2 py-1 text-xs leading-snug transition-colors ${
                          isCurrent(mod.indexId)
                            ? 'bg-primary/10 text-primary font-medium'
                            : 'text-gray-500 dark:text-gray-400 hover:text-primary'
                        }`}
                        aria-current={isCurrent(mod.indexId) ? 'page' : undefined}
                      >
                        Module overview
                      </a>
                    </li>
                  )
                }
                {
                  mod.notes.map((note) => {
                    const active = isCurrent(note.id);
                    return (
                      <li>
                        <a
                          href={noteHref('/fundamentals', note.id)}
                          class={`block rounded-md px-2 py-1 text-xs leading-snug transition-colors ${
                            active
                              ? 'bg-primary/10 text-primary font-medium'
                              : 'text-gray-500 dark:text-gray-400 hover:text-primary'
                          }`}
                          aria-current={active ? 'page' : undefined}
                        >
                          {note.title}
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </details>
          </li>
        );
      })
    }

    {
      topic.looseNotes.length > 0 && (
        <li class="pt-2 mt-2 border-t border-gray-100 dark:border-gray-700/80">
          <p class="px-2 py-1 text-xs font-semibold text-gray-400">Other notes</p>
          <ul class="space-y-0.5">
            {topic.looseNotes.map((note) => {
              const active = isCurrent(note.id);
              return (
                <li>
                  <a
                    href={noteHref('/fundamentals', note.id)}
                    class={`block rounded-md px-2 py-1 text-xs leading-snug transition-colors ${
                      active
                        ? 'bg-primary/10 text-primary font-medium'
                        : 'text-gray-500 dark:text-gray-400 hover:text-primary'
                    }`}
                    aria-current={active ? 'page' : undefined}
                  >
                    {note.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </li>
      )
    }
  </ul>
</nav>
