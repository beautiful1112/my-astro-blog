---
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_AVATAR,
  SOCIAL_LINKS,
  BLOG_SECTIONS,
  SITE_TAGS,
  sectionHref,
} from '../consts';

const currentPath = Astro.url.pathname;

function isActive(section: (typeof BLOG_SECTIONS)[number]): boolean {
  const href = sectionHref(section);
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<aside class="space-y-6">
  <div class="bg-white dark:bg-[var(--color-card-dark)] rounded-2xl shadow-sm p-6 text-center">
    <img
      src={SITE_AVATAR}
      alt={SITE_AUTHOR}
      class="w-24 h-24 rounded-full mx-auto mb-4 object-cover ring-2 ring-primary/20"
      width="96"
      height="96"
    />
    <h2 class="font-semibold text-lg text-gray-900 dark:text-gray-100">{SITE_AUTHOR}</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{SITE_DESCRIPTION}</p>

    <div class="flex items-center justify-center gap-4 mt-5">
      {SOCIAL_LINKS.map((link) => (
        <a
          href={link.href}
          target={link.icon === 'rss' ? undefined : '_blank'}
          rel={link.icon === 'rss' ? undefined : 'noopener noreferrer'}
          class="text-gray-500 dark:text-gray-400 hover:text-primary transition-colors"
          title={link.name}
        >
          {link.icon === 'github' && (
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          )}
          {link.icon === 'linkedin' && (
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          )}
          {link.icon === 'rss' && (
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
          )}
        </a>
      ))}
    </div>
  </div>

  <nav class="bg-white dark:bg-[var(--color-card-dark)] rounded-2xl shadow-sm px-5 py-4">
    <ul class="space-y-1">
      {BLOG_SECTIONS.map((section) => (
        <li>
          <a
            href={sectionHref(section)}
            class={`block py-2 text-sm transition-colors ${
              isActive(section)
                ? 'font-semibold text-gray-900 dark:text-gray-100'
                : 'text-gray-500 dark:text-gray-400 hover:text-primary'
            }`}
          >
            {section.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="bg-white dark:bg-[var(--color-card-dark)] rounded-2xl shadow-sm px-5 py-4">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-3">Tags</h2>
    <div class="flex flex-wrap gap-2">
      {SITE_TAGS.map((tag) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          class="text-xs px-3 py-1.5 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-primary hover:text-white dark:hover:bg-primary transition-colors"
        >
          {tag}
        </a>
      ))}
    </div>
  </div>
</aside>
