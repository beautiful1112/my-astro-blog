---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import PostList from '../../components/PostList.astro';
import { resolveCover } from '../_imageStore';
import {
  BLOG_CATEGORIES,
  CATEGORY_BY_SLUG,
  SLUG_BY_CATEGORY,
  slugifyCategory,
} from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const slugs = new Set<string>(Object.keys(CATEGORY_BY_SLUG));

  for (const post of posts) {
    const cat = post.data.category;
    if (!cat) continue;
    slugs.add(SLUG_BY_CATEGORY[cat] ?? slugifyCategory(cat));
    if (cat.includes('/')) {
      const parts = cat.split('/');
      for (let i = 0; i < parts.length; i++) {
        const subCat = parts.slice(0, i + 1).join('/');
        slugs.add(SLUG_BY_CATEGORY[subCat] ?? slugifyCategory(subCat));
      }
    }
  }

  return Array.from(slugs).map((slug) => ({ params: { category: slug } }));
}

const { category: slug } = Astro.params;
const categoryName = CATEGORY_BY_SLUG[slug!] ?? slug!;
const allPosts = await getCollection('blog');

const filtered = allPosts
  .filter((post) => {
    const cat = post.data.category;
    if (!cat) return false;
    return cat === categoryName || cat.startsWith(`${categoryName}/`);
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postData = filtered.map((p) => ({
  ...p,
  slug: p.id,
  data: {
    ...p.data,
    cover: resolveCover('blog', p.id, p.data.cover),
  },
}));

const displayName = categoryName.split('/').pop()!;
---

<BlogLayout title={displayName}>
  <h1 class="text-2xl font-bold mb-8 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    Category: {displayName}
    <span class="text-base font-normal text-gray-400">
      ({filtered.length} posts)
    </span>
  </h1>
  {filtered.length > 0 ? (
    <PostList posts={postData} showPinned />
  ) : (
    <p class="text-gray-500 dark:text-gray-400">No posts in this section yet. Check back soon.</p>
  )}
</BlogLayout>
