---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { buildNoteTopics, noteHref, noteTitle, topicHref } from '../../utils/notes';

const notes = (await getCollection('fundamentals'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));

const metas = notes.map((n) => ({
  id: n.id,
  title: noteTitle(n.id, n.body, n.data.title),
}));

const topics = buildNoteTopics(metas);
---

<BlogLayout title="Fundamentals">
  <h1 class="text-2xl font-bold mb-2 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    Fundamentals
  </h1>
  <p class="text-sm text-gray-400 dark:text-gray-500 mb-8">
    Network fundamentals study notes — multicast, BGP, and related deep-dives.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {
      topics.map((topic) => {
        const noteCount = topic.modules.reduce((sum, m) => sum + m.notes.length, 0);
        return (
          <a
            href={topicHref(topic.id)}
            class="block rounded-2xl border border-gray-200 dark:border-gray-700 p-6 hover:border-primary/40 hover:bg-primary/5 transition-colors"
          >
            <h2 class="text-xl font-bold capitalize mb-2">{topic.label}</h2>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
              {topic.modules.length} modules · {noteCount} notes
            </p>
            <span class="text-sm font-medium text-primary">Open master index →</span>
          </a>
        );
      })
    }
  </div>

  {
    topics.some((t) => t.deepDive) && (
      <section class="mt-12">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-3">
          Legacy deep-dive documents
        </h2>
        <ul class="space-y-2 text-sm">
          {topics
            .filter((t) => t.deepDive)
            .map((t) => (
              <li>
                <a
                  href={noteHref('/fundamentals', t.deepDive!.id)}
                  class="text-gray-600 dark:text-gray-300 hover:text-primary transition-colors"
                >
                  {t.deepDive!.title}
                </a>
              </li>
            ))}
        </ul>
      </section>
    )
  }
</BlogLayout>
