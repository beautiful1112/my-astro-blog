---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { buildNoteTopics, noteHref, noteTitle } from '../../utils/notes';

const notes = (await getCollection('fundamentals'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));

const metas = notes.map((n) => ({
  id: n.id,
  title: noteTitle(n.id, n.body, n.data.title),
}));

const topics = buildNoteTopics(metas);
---

<BlogLayout title="Fundamentals">
  <h1 class="text-2xl font-bold mb-2 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    Fundamentals
  </h1>
  <p class="text-sm text-gray-400 dark:text-gray-500 mb-8">
    Network fundamentals study notes — multicast, BGP, and related deep-dives.
  </p>

  <div class="space-y-12">
    {
      topics.map((topic) => (
        <section>
          <div class="flex flex-wrap items-end justify-between gap-3 mb-5 pb-3 border-b border-gray-200 dark:border-gray-700">
            <h2 class="text-xl font-bold capitalize">{topic.label}</h2>
            {topic.deepDive && (
              <a
                href={noteHref('/fundamentals', topic.deepDive.id)}
                class="text-sm font-medium text-primary hover:underline"
              >
                Open master index →
              </a>
            )}
          </div>

          {topic.deepDive && (
            <a
              href={noteHref('/fundamentals', topic.deepDive.id)}
              class="block mb-6 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4 hover:border-primary/40 transition-colors"
            >
              <p class="text-xs uppercase tracking-wide text-primary/80 mb-1">Master index</p>
              <p class="font-semibold text-gray-900 dark:text-gray-100">{topic.deepDive.title}</p>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                Start here for the full module map and recommended study sequence.
              </p>
            </a>
          )}

          <div class="space-y-6">
            {topic.modules.map((mod) => (
              <div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  {mod.indexId ? (
                    <a
                      href={noteHref('/fundamentals', mod.indexId)}
                      class="font-semibold text-gray-900 dark:text-gray-100 hover:text-primary transition-colors"
                    >
                      {mod.label}
                    </a>
                  ) : (
                    <h3 class="font-semibold text-gray-900 dark:text-gray-100">{mod.label}</h3>
                  )}
                  <span class="text-xs text-gray-400">
                    {mod.notes.length} note{mod.notes.length === 1 ? '' : 's'}
                  </span>
                </div>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 pl-0 sm:pl-1">
                  {mod.notes.map((note) => (
                    <li>
                      <a
                        href={noteHref('/fundamentals', note.id)}
                        class="text-sm text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
                      >
                        {note.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {topic.looseNotes.length > 0 && (
              <ul class="space-y-1.5">
                {topic.looseNotes.map((note) => (
                  <li>
                    <a
                      href={noteHref('/fundamentals', note.id)}
                      class="text-sm text-gray-600 dark:text-gray-300 hover:text-primary transition-colors"
                    >
                      {note.title}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))
    }
  </div>
</BlogLayout>
