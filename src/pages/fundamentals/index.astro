---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { formatRootLabel, groupNotesByRoot, noteHref, noteTitle } from '../../utils/notes';

const notes = (await getCollection('fundamentals'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));

const groups = groupNotesByRoot(notes.map((n) => n.id));
const titleById = new Map(
  notes.map((n) => [n.id, noteTitle(n.id, n.body, n.data.title)]),
);

const deepDives = notes.filter(
  (n) => n.id.endsWith('Multicast_Deep_Dive') || n.id.endsWith('BGP_Deep_Dive'),
);
---

<BlogLayout title="Fundamentals">
  <h1 class="text-2xl font-bold mb-2 flex items-center gap-2">
    <span class="w-1 h-6 bg-primary rounded-full inline-block"></span>
    Fundamentals
  </h1>
  <p class="text-sm text-gray-400 dark:text-gray-500 mb-8">
    Network fundamentals study notes — multicast, BGP, and related deep-dives.
  </p>

  {
    deepDives.length > 0 && (
      <section class="mb-10">
        <h2 class="text-lg font-semibold mb-4">Start here</h2>
        <ul class="space-y-2">
          {deepDives.map((note) => (
            <li>
              <a
                href={noteHref('/fundamentals', note.id)}
                class="text-primary hover:underline"
              >
                {titleById.get(note.id)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    Array.from(groups.entries()).map(([root, ids]) => (
      <section class="mb-10">
        <h2 class="text-lg font-semibold mb-4">{formatRootLabel(root)}</h2>
        <ul class="space-y-1.5 text-sm">
          {ids.map((id) => (
            <li>
              <a
                href={noteHref('/fundamentals', id)}
                class="text-gray-600 dark:text-gray-300 hover:text-primary dark:hover:text-primary transition-colors"
              >
                {titleById.get(id)}
              </a>
              <span class="ml-2 text-xs text-gray-400">{id}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BlogLayout>
