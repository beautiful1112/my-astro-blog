---
import BlogLayout from '../layouts/BlogLayout.astro';
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
---

<BlogLayout title="About">
  <article class="prose max-w-none">
      <h1>About</h1>
      <p>
        Hi, I'm {SITE_AUTHOR}. I write about networking, automation, and DevOps — sharing what I learn along the way.
      </p>
      <p>
        This blog covers network fundamentals, routing &amp; switching, containers, automation, Linux, and personal reflections on the journey.
      </p>
      <h2>Connect</h2>
      <ul>
        {SOCIAL_LINKS.filter((link) => link.icon !== 'rss').map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.name}</a>
          </li>
        ))}
      </ul>
    </article>
</BlogLayout>
